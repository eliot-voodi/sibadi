DB_NAME=university
DB_USER=postgres
DB_PASS=change_me
SECRET_KEY=change_me_to_long_random_value

# Disabled by default for safety. Enable only for first run.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_LOGIN=admin
ADMIN_BOOTSTRAP_PASSWORD=

# TLS certificate common name for nginx self-signed cert
SSL_CN=localhost
