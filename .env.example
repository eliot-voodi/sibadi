DB_NAME=university

# Роль приложения (минимальные права в БД). Совпадает с APP_DB_USER в контейнере db.
DB_USER=sibadi_app
DB_PASS=change_me_app_password

# Пароль суперпользователя postgres в контейнере БД (администрирование, pg_dump и т.д.).
# Если не задан — берётся значение DB_PASS (удобно для dev).
POSTGRES_SUPER_PASSWORD=

# SECRET_KEY: в продакшене ≥32 символа случайной строки (не оставляйте change_me).
SECRET_KEY=change_me_to_long_random_value_at_least_32_chars

# false (по умолчанию): при первом обращении к приложению создаётся admin с паролем по ГОСТ/ФСТЭК — один раз в stderr (docker logs).
# true: задать пароль явно в ADMIN_BOOTSTRAP_PASSWORD.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_LOGIN=admin
ADMIN_BOOTSTRAP_PASSWORD=

# Канал к PostgreSQL: prefer | require | verify-full (см. документацию libpq).
PGSSLMODE=prefer
# Если задано — переопределяет PGSSLMODE только для приложения (не для клиентов на хосте).
# DB_SSLMODE=

# Пул соединений приложения
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=10
DB_APPLICATION_NAME=sibadi-web

# Ограничение частоты запросов к /login (Flask-Limiter). Для нескольких воркеров — Redis: redis://redis:6379
RATE_LIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=60 per minute
LOGIN_RATE_LIMIT_POST=12 per minute

# Блокировка IP после серии неудачных входов (окно и порог по времени; счётчик в памяти процесса)
LOGIN_BF_WINDOW_SEC=600
LOGIN_BF_MAX_ATTEMPTS=8
LOGIN_BF_LOCKOUT_SEC=900

# TLS certificate common name for nginx self-signed cert
SSL_CN=127.0.0.1
